{
  "name": "atl",
  "version": "0.1.0",
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "^7.0.2"
  },
  "bin": {
    "atl": "src/main.ts"
  },
  "description": "JSON CLI for Confluence and Jira Cloud over REST, using the Atlassian MCP OAuth flow",
  "packageManager": "bun@>=1.4",
  "private": true,
  "scripts": {
    "atl": "bun src/main.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint -c .oxlintrc.json --type-aware --deny-warnings src test scripts",
    "lint:fix": "oxlint -c .oxlintrc.json --type-aware --deny-warnings --fix src test scripts",
    "fmt": "oxfmt -c .oxfmtrc.json src test scripts",
    "fmt:check": "oxfmt -c .oxfmtrc.json --check src test scripts",
    "check": "bun run typecheck && bun run lint && bun run fmt:check && bun run test",
    "build": "bun build --compile --minify --bytecode src/main.ts --outfile dist/atl",
    "build:windows": "bun build --compile --minify --bytecode --target=bun-windows-x64 src/main.ts --outfile dist/atl.exe",
    "build:linux": "bun build --compile --minify --bytecode --target=bun-linux-x64 src/main.ts --outfile dist/atl-linux"
  },
  "type": "module"
}
